# INDAGO Evidence Capture Platform - Environment Configuration
# Copy this file to .env and adjust values for your deployment

# Application
APP_NAME=INDAGO Evidence Capture
DEBUG=false
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_IN_PRODUCTION

# Database
DATABASE_URL=postgresql+asyncpg://indago:indago_secret@localhost:5432/indago_db
DATABASE_URL_SYNC=postgresql://indago:indago_secret@localhost:5432/indago_db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Object Storage (MinIO / S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=indago_access
S3_SECRET_KEY=indago_secret_key
S3_BUCKET_EVIDENCE=indago-evidence
S3_BUCKET_REPORTS=indago-reports

# Evidence Storage
EVIDENCE_BASE_PATH=/evidence_storage

# Trusted Timestamp Authority (RFC 3161)
TSA_URL=https://freetsa.org/tsr

# Capture Settings
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
PAGE_LOAD_TIMEOUT_MS=60000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
